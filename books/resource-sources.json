      "bookLinkPattern": "^/txt/[0-9]+[.]html$",
      "downloadPagePattern": "^/txt/dl-[0-9]+-[0-9]+[.]html$",
      "downloadLinkPattern": "^https://jjxswshuku[.]com/e/DownSys/doaction[.]php[?].*pathid=0(&|$)",
      "downloadFormat": "txt",
      "authorPattern": "书籍作者[：:]</strong>[[:space:]]*<a[^>]*>([^<]+)</a>",
